# Copy this file to .env and fill it in. Never commit .env.

# Your chess.com username (can also be passed on the command line).
CHESSGURU_USERNAME=

# Contact details sent in the User-Agent header, as chess.com asks.
# An email address or a link to this project is fine.
CHESSGURU_CONTACT=

# Where downloaded games and the DuckDB file are stored.
CHESSGURU_DATA_DIR=./data

# Path to the Stockfish binary. Leave blank to find "stockfish" on your PATH.
CHESSGURU_STOCKFISH_PATH=

# Engine search depth. Higher is more accurate but slower.
CHESSGURU_ENGINE_DEPTH=14

# How many of your most recent games to analyse.
CHESSGURU_MAX_GAMES=30

# Secret key used to hash opponent usernames. Any long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
CHESSGURU_HASH_KEY=
